# Security headers for hosts that read a _headers file from the publish root (e.g. Cloudflare Pages).
# Scoped to the Banikuppa school site; keep in sync with ResidentialSchoolBanikuppa/.htaccess.
/ResidentialSchoolBanikuppa/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Privacy: ask search engines not to list photographs of pupils and staff in image search.
/ResidentialSchoolBanikuppa/assets/images/*
  X-Robots-Tag: noimageindex

# Privacy for the recovered photographs of pupils and staff (generated by tools/generate_portal.py)
/portal-assets/recovered/*
  X-Robots-Tag: noimageindex
